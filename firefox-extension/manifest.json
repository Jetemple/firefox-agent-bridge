{
  "manifest_version": 2,
  "name": "Claude Firefox Bridge",
  "version": "0.2.0",
  "description": "Lets Claude Desktop drive Firefox via a local MCP bridge over WebSocket.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-firefox-bridge@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self';",
  "background": {
    "scripts": [
      "restricted.js",
      "tools/tabs-summary.js",
      "tools/navigate.js",
      "tools/screenshot.js",
      "tools/get-page-text.js",
      "tools/click.js",
      "tools/type.js",
      "tools/javascript-tool.js",
      "tools/close-tab.js",
      "tools/activate-tab.js",
      "tools/reload.js",
      "tools/back.js",
      "tools/forward.js",
      "tools/press-key.js",
      "tools/scroll.js",
      "tools/hover.js",
      "tools/double-click.js",
      "tools/right-click.js",
      "tools/drag.js",
      "tools/select-option.js",
      "tools/set-checkbox.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Claude Firefox Bridge",
    "default_popup": "panel.html"
  }
}
