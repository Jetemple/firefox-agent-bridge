{
  "manifest_version": 2,
  "name": "Agent Bridge for Firefox",
  "version": "0.2.2",
  "description": "Lets AI agents drive your logged-in Firefox through a local bridge (ff CLI and MCP clients).",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-agent-bridge@jetemple",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self';",
  "background": {
    "scripts": [
      "restricted.js",
      "marker.js",
      "tools/tabs-summary.js",
      "tools/navigate.js",
      "tools/open-tab.js",
      "tools/screenshot.js",
      "tools/get-page-text.js",
      "tools/pointer.js",
      "tools/type.js",
      "tools/javascript-tool.js",
      "tools/close-tab.js",
      "tools/close-agent-tabs.js",
      "tools/activate-tab.js",
      "tools/reload.js",
      "tools/back.js",
      "tools/forward.js",
      "tools/press-key.js",
      "tools/scroll.js",
      "tools/drag.js",
      "tools/select-option.js",
      "tools/set-checkbox.js",
      "tools/find-element.js",
      "tools/get-links.js",
      "tools/get-tables.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Agent Bridge for Firefox",
    "default_popup": "panel.html"
  }
}
