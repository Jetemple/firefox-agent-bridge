{
  "name": "firefox-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lets coding agents and MCP clients drive your signed-in Firefox, via the ff CLI or an MCP server, in background tabs.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash scripts/setup-firefox-bridge.sh",
    "test": "node --test firefox-mcp-bridge/*.test.mjs scripts/*.test.mjs bench/*.test.mjs",
    "lint:extension": "npx --yes web-ext@10.8.0 lint --source-dir firefox-extension",
    "sign": "npx --yes web-ext@10.8.0 sign --channel=unlisted --source-dir firefox-extension --artifacts-dir web-ext-artifacts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
